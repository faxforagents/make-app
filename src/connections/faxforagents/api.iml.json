{
    "url": "https://api.faxforagents.com/v1/me",
    "method": "GET",
    "headers": {
        "authorization": "Bearer {{parameters.apiKey}}",
        "accept": "application/json"
    },
    "response": {
        "error": {
            "type": "InvalidAccessTokenError",
            "message": "[{{statusCode}}] {{ifempty(body.error.message, 'The API key was rejected')}}. Use an ffa_test_ or ffa_live_ key from app.faxforagents.com."
        },
        "uid": "{{body.key_id}}",
        "metadata": {
            "type": "text",
            "value": "{{body.environment}} key {{body.key_prefix}}"
        }
    },
    "log": {
        "sanitize": [
            "request.headers.authorization"
        ]
    }
}
